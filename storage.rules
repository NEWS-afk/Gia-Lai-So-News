rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{allPaths=**} {
      allow read: if true;
      // Thay ADMIN_UID_HERE bằng UID tài khoản Admin.
      allow write: if request.auth != null
                   && request.auth.uid == "ADMIN_UID_HERE";
    }
  }
}
